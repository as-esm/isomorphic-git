{
  "include": [
    "src/index.ts",
    "src/internal-apis.ts",
    "http/web/index.ts",
    "http/node/index.ts",
    "managers/index.ts",
    "models/index.ts"
  ],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "types": [],
    "strictNullChecks": true,
    "allowJs": true,
    "declaration": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "moduleResolution": "node",
    "target": "ES2020",
    "module": "esnext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  }
}
