{
  "references": [{ "path": "packages/src" }],
  "include": ["__tests__",],
  "exclude": ["node_modules", "src/typedefs.js", "src/typedefs-http.js","packages/isomorphic-git","package.json"],
  "compilerOptions": {
    "incremental": false,
    "strictNullChecks": true,
    "noEmit": true,
    "outDir": "packages/isomorphic-git",
    "allowJs": true,
    "checkJs": true,
    "maxNodeModuleJsDepth": 0,
    "moduleResolution": "nodenext",
    "target": "es2023",
    "module": "nodenext",
    "isolatedModules": true,
    "lib": ["es2023", "dom"],
    "types": ["node", "@types/jest"],
    "resolveJsonModule": true,
    "sourceMap": false,
    "declaration": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // "paths": {
    //   "isomorphic-git": ["./index.d.ts"],
    //   "isomorphic-git/internal-apis": ["./src/internal-apis.d.ts"],
    //   "isomorphic-git/http": ["./http/node/index.d.ts"],
    //   "isomorphic-git/managers": ["./managers/index.d.ts"],
    //   "isomorphic-git/models": ["./models/index.d.ts"]
    // }
  }
}
